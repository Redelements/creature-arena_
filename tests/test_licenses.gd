extends TestCase
## LICENSES.md stays true: every bought-art file it lists exists, and no bought art reaches
## the logo, the icon or anything under assets/ui (Szadi's licence forbids the art in a logo,
## trademark or service mark; the wordmark is generated by tools/gen_logo.py). Store and
## marketing art is kept the same way, by hand: see docs/ip-protection-plan.md.

const LICENSES := "res://LICENSES.md"
## Headings of the sections whose file lists are bought art.
const BOUGHT_SECTIONS := ["## Szadi art", "## kiddolink"]
## Paths that must never come from bought art.
const PROTECTED_PREFIXES := ["assets/ui/", "assets/icon", "icon."]


func _sections() -> Dictionary:
	var f := FileAccess.open(LICENSES, FileAccess.READ)
	assert_true(f != null, "LICENSES.md opens")
	var out := {}
	var current := ""
	for line in f.get_as_text().split("\n"):
		if line.begins_with("## "):
			current = line.strip_edges()
			out[current] = []
		elif current != "":
			(out[current] as Array).append(line)
	return out


## The `assets/...` paths named in backticks on a section's lines.
func _listed_paths(lines: Array) -> Array[String]:
	var paths: Array[String] = []
	var re := RegEx.new()
	re.compile("`(assets/[^`]+)`")
	for line in lines:
		# Only the file list itself (bullet lines); prose may name any path, e.g. the logo rule.
		if not String(line).strip_edges().begins_with("- `assets/"):
			continue
		for m in re.search_all(String(line)):
			var p := m.get_string(1)
			if not p.ends_with("/") and not p.contains("*") and not p.contains("<"):
				paths.append(p)
	return paths


func test_every_bought_art_file_listed_exists_and_none_is_ui_art() -> void:
	var sections := _sections()
	var total := 0
	for heading in BOUGHT_SECTIONS:
		assert_true(sections.has(heading), "LICENSES.md has the section " + heading)
		var paths := _listed_paths(sections.get(heading, []))
		assert_true(paths.size() > 0, heading + " lists its files")
		for p in paths:
			total += 1
			assert_true(FileAccess.file_exists("res://" + p), heading + " lists a file that exists: " + p)
			for prefix in PROTECTED_PREFIXES:
				assert_true(not p.begins_with(prefix), heading + " must not reach the logo, icon or UI art: " + p)
	assert_true(total >= 10, "the lists are not empty (found %d files)" % total)


func test_the_logo_is_generated_not_bought() -> void:
	assert_true(FileAccess.file_exists("res://assets/ui/logo.png"), "the wordmark exists")
	assert_true(FileAccess.file_exists("res://tools/gen_logo.py"), "the wordmark's generator exists")
	var f := FileAccess.open(LICENSES, FileAccess.READ)
	var text := f.get_as_text()
	assert_true(text.contains("tools/gen_logo.py"), "LICENSES.md says the wordmark is generated")
	assert_true(text.contains("logo, trademark or"), "LICENSES.md quotes the no-logo clause")
